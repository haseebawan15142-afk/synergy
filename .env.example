# Contact form (optional until SMTP configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO=info@synergy.net.pk

NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_SITE_URL=https://synergy.net.pk

# --- Synergy Assistant — Groq (recommended) ---
# Get a free key: https://console.groq.com/keys
# Local: copy this file to .env.local and paste your key below.
# Netlify: Site configuration → Environment variables → add GROQ_API_KEY → redeploy

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Optional fallbacks if Groq is unavailable ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
