# --- SMTP (contact form + admin message replies) ---
# Use your mail host credentials (e.g. company mail server / Gmail / Outlook)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# From address shown to recipients (can match SMTP_USER)
SMTP_FROM=Synergy Computers <info@synergy.net.pk>
CONTACT_TO=info@synergy.net.pk

NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_SITE_URL=https://synergy.net.pk

# --- Firebase client SDK ---
# Console â†’ Project settings â†’ Your apps â†’ Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Firebase Admin SDK (seed script / server) ---
# Console â†’ Project settings â†’ Service accounts â†’ Generate new private key
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the private_key value; keep \n escapes as a single line in .env.local
FIREBASE_ADMIN_PRIVATE_KEY=

# Required on Vercel (recommended): short random secret for admin_gate HMAC in middleware.
# Generate: openssl rand -base64 32
# Do NOT rely on FIREBASE_ADMIN_PRIVATE_KEY alone on Edge — set this explicitly in Vercel.
ADMIN_SESSION_SECRET=

# --- Vercel (Production) checklist ---
# Project → Settings → Environment Variables → Production (+ redeploy after changes):
#   NEXT_PUBLIC_SITE_URL=https://synergy.net.pk   (or your Vercel domain)
#   NEXT_PUBLIC_FIREBASE_*   (same as local client config)
#   FIREBASE_ADMIN_PROJECT_ID
#   FIREBASE_ADMIN_CLIENT_EMAIL
#   FIREBASE_ADMIN_PRIVATE_KEY   (paste key; use real newlines OR literal \n — no wrapping quotes)
#   ADMIN_SESSION_SECRET
# Phone/admin login: use the LIVE URL (https://yoursite...), never localhost.

# First admin user (npm run admin:seed)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Dev-only — ignored in production. Never set true in production.
NEXT_PUBLIC_ADMIN_AUTH_BYPASS=false

# --- Playwright E2E (optional) ---
# Point at a running local server; set SKIP to avoid `next start`.
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# PLAYWRIGHT_SKIP_WEBSERVER=1


# --- Synergy Assistant â€” Groq (recommended) ---
# Get a free key: https://console.groq.com/keys
# Local: copy this file to .env.local and paste your key below.
# Netlify: Site configuration â†’ Environment variables â†’ add GROQ_API_KEY â†’ redeploy

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Optional fallbacks if Groq is unavailable ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
