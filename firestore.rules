rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ── Auth helpers ─────────────────────────────────────────────── */

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isPublished() {
      return resource.data.status == 'published';
    }

    function isOpenCareer() {
      return resource.data.status == 'open';
    }

    /**
     * Marketing / CMS catalog pattern:
     * - Public READ so website list queries never fail when draft/inactive
     *   docs exist (Firestore rejects the whole query otherwise).
     * - Website app code still filters status/active for display.
     * - Only admins can CREATE / UPDATE / DELETE.
     */
    function publicCatalog() {
      return true;
    }

    function validEmail(value) {
      return value is string
        && value.size() >= 3
        && value.size() <= 254
        && value.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }

    /** Allowed public contact shape (documented; creates go via /api/contact). */
    function isPublicContactCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'email', 'message', 'status', 'replyStatus', 'createdAt'])
        && d.name is string
        && d.name.size() > 0
        && d.name.size() <= 120
        && validEmail(d.email)
        && d.message is string
        && d.message.size() > 0
        && d.message.size() <= 5000
        && d.status == 'unread'
        && d.replyStatus == 'none'
        && d.createdAt == request.time;
    }

    /** Allowed public newsletter shape (documented; creates go via /api/newsletter). */
    function isPublicNewsletterCreate() {
      let d = request.resource.data;
      return (d.keys().hasOnly(['email', 'status', 'createdAt'])
          || d.keys().hasOnly(['email', 'name', 'status', 'createdAt']))
        && validEmail(d.email)
        && d.status == 'active'
        && d.createdAt == request.time
        && (!('name' in d)
          || (d.name is string && d.name.size() > 0 && d.name.size() <= 120));
    }

    /* ── Admin identity ───────────────────────────────────────────── */

    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create, update, delete: if isAdmin();
    }

    /* ── Site chrome (footer, theme, nav, SEO) ─────────────────────── */

    match /settings/{docId} {
      allow read: if publicCatalog();
      allow write: if isAdmin();
    }

    match /theme/{docId} {
      allow read: if publicCatalog();
      allow write: if isAdmin();
    }

    /* Admin CMS theme library — signed-in staff can read; only admins write. */
    match /themePresets/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /navigation/{docId} {
      allow read: if publicCatalog();
      allow write: if isAdmin();
    }

    match /seo/{document=**} {
      allow read: if publicCatalog();
      allow write: if isAdmin();
    }

    match /media/{id} {
      allow read: if publicCatalog();
      allow write: if isAdmin();
    }

    match /categories/{id} {
      allow read: if publicCatalog();
      allow write: if isAdmin();
    }

    match /tags/{id} {
      allow read: if publicCatalog();
      allow write: if isAdmin();
    }

    /* ── Website content managed in Admin CMS ─────────────────────── */
    /* App filters drafts/inactive; public list/detail stays reliable. */

    match /partners/{id} {
      allow read: if publicCatalog();
      allow write: if isAdmin();
    }

    match /clients/{id} {
      allow read: if publicCatalog();
      allow write: if isAdmin();
    }

    match /services/{id} {
      allow read: if publicCatalog();
      allow write: if isAdmin();
    }

    match /leadership/{id} {
      allow read: if publicCatalog();
      allow write: if isAdmin();
    }

    match /offices/{id} {
      allow read: if publicCatalog();
      allow write: if isAdmin();
    }

    match /industries/{id} {
      allow read: if publicCatalog();
      allow write: if isAdmin();
    }

    match /alumni/{id} {
      allow read: if publicCatalog();
      allow write: if isAdmin();
    }

    match /testimonials/{id} {
      allow read: if publicCatalog();
      allow write: if isAdmin();
    }

    match /gallery/{id} {
      allow read: if publicCatalog();
      allow write: if isAdmin();
    }

    match /galleryAlbums/{id} {
      allow read: if publicCatalog();
      allow write: if isAdmin();
    }

    match /faq/{id} {
      allow read: if publicCatalog();
      allow write: if isAdmin();
    }

    match /events/{id} {
      allow read: if publicCatalog();
      allow write: if isAdmin();
    }

    match /caseStudies/{id} {
      allow read: if publicCatalog();
      allow write: if isAdmin();
    }

    match /newsletterIssues/{id} {
      allow read: if publicCatalog();
      allow write: if isAdmin();
    }

    /**
     * Blogs — drafts must NOT be world-readable by document ID.
     * Public site MUST query: where("status", "==", "published")
     */
    match /blogs/{id} {
      allow read: if isAdmin() || isPublished();
      allow write: if isAdmin();
    }

    /**
     * Careers — closed/draft jobs stay private.
     * Public site MUST query: where("status", "==", "open")
     */
    match /careers/{id} {
      allow read: if isAdmin() || isOpenCareer() || isPublished();
      allow write: if isAdmin();
    }

    /**
     * Form intakes — public create DISABLED.
     * Website forms use POST /api/contact and POST /api/newsletter (Admin SDK).
     */
    match /messages/{id} {
      allow create, read, update, delete: if isAdmin();
    }

    match /newsletter/{id} {
      allow create, read, update, delete: if isAdmin();
    }

    /* ── Private admin ops ────────────────────────────────────────── */

    match /analytics/{document=**} {
      allow read, write: if isAdmin();
    }

    match /auditLogs/{id} {
      allow read, write: if isAdmin();
    }

    match /activities/{id} {
      allow read, write: if isAdmin();
    }

    /* Daily theme scheduler logs (admin-only). */
    match /themeAutomationLogs/{id} {
      allow read, write: if isAdmin();
    }
  }
}
